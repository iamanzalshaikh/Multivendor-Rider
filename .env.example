# ─── Local dev (expo start / debug) ───
# Replace 192.168.1.102 with your PC LAN IP (ipconfig → IPv4)
# Android emulator: 10.0.2.2 reaches host machine
EXPO_PUBLIC_API_URL=http://192.168.1.102:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.102:5000
# EXPO_PUBLIC_ANDROID_API_HOST=10.0.2.2

# ─── Production (Render) — already in .env.production for APK builds ───
# EXPO_PUBLIC_API_URL=https://zomato-backend-pt66.onrender.com/api/v1
# EXPO_PUBLIC_SOCKET_URL=https://zomato-backend-pt66.onrender.com

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_GEOCODING_KEY=
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
EXPO_PUBLIC_GOOGLE_ROUTES_KEY=
