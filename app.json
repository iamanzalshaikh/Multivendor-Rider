{
  "expo": {
    "name": "SD Services Rider",
    "slug": "riderApp",
    "description": "SD Services Rider — campus delivery partner app for CASE Jamaica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "riderapp",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#FF5A00",
      "androidMode": "default",
      "androidCollapsedTitle": "SD Services Rider"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ff5a00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.edenzatech.sdservice.rider",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.edenzatech.sdservice.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "usesCleartextTraffic": true
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SD Services Rider uses your location for delivery navigation while on an active trip."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF5A00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SD Services Rider needs photo access to upload KYC documents.",
          "cameraPermission": "SD Services Rider needs camera access to capture KYC documents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ff5a00",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6d923d26-0ac5-4ec4-9d6e-626beaa7761d"
      }
    },
    "owner": "herridez"
  }
}
